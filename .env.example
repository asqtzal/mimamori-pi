# mimamori-pi Environment Variables
# このファイルを .env にコピーして、環境に合わせて値を設定してください
# 例: cp .env.example .env

# =============================================================================
# Flask Application Settings
# =============================================================================
# Flaskサーバーのホスト（0.0.0.0でLAN内からアクセス可能）
FLASK_HOST=0.0.0.0

# Flaskサーバーのポート番号
FLASK_PORT=5000

# Flaskのシークレットキー（セッション管理用）
# 本番環境では、以下のコマンドでランダムな値を生成してください:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_in_production

# デバッグモード（開発時のみTrue、本番環境ではFalse）
FLASK_DEBUG=False

# =============================================================================
# Camera Settings
# =============================================================================
# カメラ解像度（幅x高さ）
# 推奨: 640x480 (Raspberry Pi Zero 2 Wでの動作を考慮)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# フレームレート（fps）
# 推奨: 15 (Raspberry Pi Zero 2 Wでの動作を考慮)
CAMERA_FRAMERATE=15

# カメラの回転角度（0, 90, 180, 270のいずれか）
CAMERA_ROTATION=0

# =============================================================================
# Storage Settings
# =============================================================================
# データディレクトリのパス
DATA_DIR=./data

# スナップショット保存ディレクトリのパス
SNAPSHOT_DIR=./data/snapshots

# ログファイル保存ディレクトリのパス
LOG_DIR=./data/logs

# ストレージ自動クリーンアップの閾値（%）
# この値を超えると、古い画像から自動削除されます
STORAGE_CLEANUP_THRESHOLD=90

# =============================================================================
# Snapshot Settings
# =============================================================================
# スナップショット撮影間隔（分）
# 選択肢: 5, 10, 30, 60
SNAPSHOT_INTERVAL=10

# スナップショット自動撮影の初期状態（True/False）
SNAPSHOT_AUTO_START=False

# =============================================================================
# Logging Settings
# =============================================================================
# ログレベル（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# ログファイルの最大サイズ（バイト）
LOG_MAX_BYTES=10485760

# ログファイルのバックアップ数
LOG_BACKUP_COUNT=5
